model Category {
  id          String        @default(uuid())
  name        String
  business    Businesses    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId  String
  products    Product[]

  @@id([id, businessId])

  @@unique([businessId, name])
  @@index([businessId])
  @@map("categories")
}
