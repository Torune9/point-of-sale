model Product {
  id          String        @id @default(uuid())
  name        String
  sku         String
  price       Float
  stock       Int           @default(0)
  barcode     String?
  category    Category?     @relation(fields: [categoryId,businessId], references: [id,businessId], onDelete: Restrict)
  categoryId  String?
  business    Businesses    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId  String
  movements   StockMovement[]
  items       Item[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([sku, businessId])
  @@unique([businessId, barcode])
  @@index([businessId])
  @@map("products")
}
